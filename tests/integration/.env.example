# Copy to tests/integration/.env to set this machine up for integration tests.
#
# That file is gitignored, and its presence is what arms the pre-push
# integration gate (scripts/integration_gate.sh) - a machine without it skips
# integration tests entirely. The values below are throwaway credentials for a
# local stack that integration_stop.sh deletes, volumes included.

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

MINIO_BUCKET=cveta2-test

# CVAT proxies outbound S3 through smokescreen, which denies private ranges by
# default — without this it cannot reach the MinIO container.
SMOKESCREEN_OPTS=--unsafe-allow-private-ranges

CLICKHOUSE_DB=cvat
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=user
CLICKHOUSE_PASSWORD=user
