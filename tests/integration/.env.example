# Copy to tests/integration/.env to set this machine up for integration tests.
#
# That file is gitignored, and its presence is what arms the pre-push
# integration gate (scripts/integration_gate.sh) - a machine without it skips
# integration tests entirely.
#
# CVAT is the persistent stand in the local Kubernetes cluster (see the
# k8s-infra skill). The tests act as a dedicated non-superuser account inside
# one organization; scripts/integration_up.sh registers both on first use, so
# pick the password here before the first run. A later change of the password
# does not reach an already registered user: log in to the stand and change it
# there too.
CVAT_INTEGRATION_HOST=http://cvat.k8s.localhost
CVAT_INTEGRATION_USER=cveta2
CVAT_INTEGRATION_PASSWORD=choose-a-password
CVAT_INTEGRATION_ORG=cveta2-tests

# MinIO runs in Docker Compose next to the tests (tests/integration/docker-compose.yml).
MINIO_BUCKET=cveta2-test
